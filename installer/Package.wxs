<?xml version="1.0" encoding="utf-8"?>
<!--
  Instalator WU_Connector — connector wezurlop ↔ R2Płatnik (ARCHITEKTURA-agenta.md §1, §3).
  Budowanie: build\publikuj.ps1 (publikuje aplikacje do artefakty\app, potem ten pakiet).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="WU_Connector"
           Manufacturer="wezurlop"
           Version="$(Wersja)"
           UpgradeCode="6B0C8A5E-2F4D-4A7B-9E31-7C1D5A0F4E21"
           Scope="perMachine"
           Language="1045"
           Codepage="1250">

    <SummaryInformation Description="Connector programu kadrowego R2Płatnik dla aplikacji wezurlop" />

    <!-- Aktualizacja: nowa wersja zastepuje stara; konfiguracja, stan i magazyn bibliotek w ProgramData zostaja. -->
    <MajorUpgrade DowngradeErrorMessage="Zainstalowana jest nowsza wersja WU_Connector." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Proces roboczy (zapis do R2) dziala na .NET Framework 4.8 — jest w kazdym aktualnym Windows Server. -->
    <Property Id="NETFX48">
      <RegistrySearch Id="SzukajNetFx48" Root="HKLM" Key="SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full" Name="Release" Type="raw" />
    </Property>
    <Launch Condition="Installed OR (NETFX48 AND NETFX48 &gt;= &quot;#528040&quot;)"
            Message="Connector wymaga .NET Framework 4.8. Zainstaluj go z Windows Update i uruchom instalator ponownie." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="WU_Connector" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DANEFOLDER" Name="WU_Connector">
        <Directory Id="DZIENNIKFOLDER" Name="dziennik" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Connector" Title="WU_Connector" Level="1">
      <ComponentGroupRef Id="Aplikacja" />
      <ComponentRef Id="Usluga" />
      <ComponentRef Id="KatalogDanych" />
      <ComponentRef Id="KatalogDziennika" />
      <ComponentRef Id="Autostart" />
      <ComponentRef Id="Skrot" />
    </Feature>
  </Package>

  <Fragment>
    <!-- Wszystkie pliki aplikacji (usluga, okno, proces roboczy w worker\) — poza plikiem uslugi, ktory ma wlasny komponent. -->
    <ComponentGroup Id="Aplikacja" Directory="INSTALLFOLDER">
      <Files Include="$(Aplikacja)\**">
        <Exclude Files="$(Aplikacja)\WuConnector.Service.exe" />
        <Exclude Files="$(Aplikacja)\WuConnector.Okno.exe" />
        <Exclude Files="$(Aplikacja)\**\*.pdb" />
      </Files>
    </ComponentGroup>

    <!--
      Usluga: konto LocalSystem (logowanie Windows do SQL; DPAPI maszyny), start automatyczny opozniony,
      restart po awarii po 60 s. Instalator jej NIE uruchamia — bez konfiguracji nie ma czego robic;
      uruchamia ja okno po zapisaniu konfiguracji.
    -->
    <Component Id="Usluga" Directory="INSTALLFOLDER">
      <File Id="UslugaExe" Source="$(Aplikacja)\WuConnector.Service.exe" KeyPath="yes" />
      <ServiceInstall Id="UslugaInstaluj"
                      Name="WU_Connector"
                      DisplayName="WU_Connector (R2Płatnik)"
                      Description="Wymiana danych kadrowych i wniosków urlopowych między R2Płatnikiem a aplikacją wezurlop."
                      Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Vital="yes">
        <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="60" ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="UslugaSteruj" Name="WU_Connector" Stop="both" Remove="uninstall" Wait="yes" />
    </Component>

    <!--
      Konfiguracja zawiera zaszyfrowane hasla (DPAPI maszyny — odszyfruje je kazdy proces na tej maszynie),
      wiec katalog: tylko SYSTEM i Administratorzy, bez dziedziczenia z ProgramData.
      Permanent: odinstalowanie nie kasuje konfiguracji, stanu ani magazynu bibliotek.
    -->
    <Component Id="KatalogDanych" Directory="DANEFOLDER" Guid="3E7F1B2C-8D4A-4C6E-A1F0-5B9D2E7C4A13" Permanent="yes" KeyPath="yes">
      <CreateFolder>
        <PermissionEx Sddl="O:SYG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
      </CreateFolder>
    </Component>

    <!-- Dziennik do odczytu dla uzytkownikow — ikona w zasobniku pokazuje stan bez uprawnien administratora. -->
    <Component Id="KatalogDziennika" Directory="DZIENNIKFOLDER" Guid="9C2D4E6F-1A3B-4D5C-8E7F-0A1B2C3D4E5F" Permanent="yes" KeyPath="yes">
      <CreateFolder>
        <PermissionEx Sddl="O:SYG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;FR;;;BU)" />
      </CreateFolder>
    </Component>

    <!-- Ikona w zasobniku startuje przy logowaniu kazdego uzytkownika (schowana). -->
    <Component Id="Autostart" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="WU_Connector"
                     Type="string" Value="&quot;[INSTALLFOLDER]WuConnector.Okno.exe&quot; --zasobnik" KeyPath="yes" />
    </Component>

    <!-- Okno z wlasnym komponentem: skrot w menu Start wisi na pliku (wymog ICE dla pakietu perMachine). -->
    <Component Id="Skrot" Directory="INSTALLFOLDER">
      <File Id="OknoExe" Source="$(Aplikacja)\WuConnector.Okno.exe" KeyPath="yes">
        <Shortcut Id="SkrotOkno" Directory="ProgramMenuFolder" Name="WU_Connector" Advertise="yes"
                  Description="Konfiguracja i stan connectora R2Płatnik" WorkingDirectory="INSTALLFOLDER" />
      </File>
    </Component>
  </Fragment>
</Wix>
