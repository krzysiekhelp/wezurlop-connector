<Project Sdk="WixToolset.Sdk/5.0.2">

  <!-- Budowane przez build\publikuj.ps1 — najpierw publikacja aplikacji do artefakty\app. -->
  <PropertyGroup>
    <!-- Domyslnie ta sama wersja co aplikacja (build\wersja.txt przez Directory.Build.props),
         zeby `dotnet build installer\…` bez parametru nie zbudowal MSI z innym numerem niz binaria. -->
    <Wersja Condition="'$(Wersja)' == ''">$(WersjaProduktu)</Wersja>
    <OutputName>WU_Connector-$(Wersja)</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>Wersja=$(Wersja);Aplikacja=$(MSBuildThisFileDirectory)..\artefakty\app</DefineConstants>
    <OutputPath>$(MSBuildThisFileDirectory)..\artefakty\</OutputPath>
    <SuppressIces>ICE61</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
