<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <!--
      Jawne podniesienie zaleznosci PRZECHODNIEJ. Microsoft.Data.SqlClient 7.1.0 ciagnie
      System.Security.Cryptography.Pkcs 9.0.18, ktory ma dwie znane luki: GHSA-846f-f764-76mx
      (wysoka, NU1903) i GHSA-2fmv-rv2c-59x7 (umiarkowana, NU1902).

      10.0.13 to NAJNIZSZA zalatana wersja w linii 10.x; 10.0.12 jest jeszcze podatna.
      Numerycznie nizszy 9.0.21 tez jest zalatany, ale nalezy do poprzedniej linii
      i w aplikacji net10.0 bylby krokiem w tyl. Sprawdzone poleceniem
      `dotnet list package` z przelacznikiem vulnerable: 9.0.19, 9.0.20 i 10.0.12 zglaszaja
      oba ostrzezenia, 9.0.21 i 10.0.13 zadnego.

      Wystarczy to jedno odwolanie: Service, Okno, Tests, AtrapaTenanta i Manifest biora pakiet
      przechodnio z Core, a Core jest jedynym projektem, ktory uzywa SqlClient. Po podniesieniu
      SqlClienta do wersji, ktora sama ciagnie zalatany Pkcs, ten wpis mozna usunac.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WuConnector.Contracts\WuConnector.Contracts.csproj" />
  </ItemGroup>

</Project>
